{
  "version": "1.0",
  "description": "Response playbooks for the AI agent - covers the 5 most common incident types we identified during research",
  "playbooks": [
    {
      "incident_type": "Phishing",
      "severity_levels": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "detection_indicators": [
        "Suspicious email sender domain",
        "Malicious link in email body",
        "User reported suspicious email",
        "Credential harvesting attempt detected"
      ],
      "response_steps": [
        {
          "step": 1,
          "action": "Isolate affected user account",
          "responsible": "SOC Analyst",
          "time_limit": "15 minutes"
        },
        {
          "step": 2,
          "action": "Block the malicious sender and domain in email gateway",
          "responsible": "Email Admin",
          "time_limit": "10 minutes"
        },
        {
          "step": 3,
          "action": "Reset user credentials and enable MFA",
          "responsible": "IT Admin",
          "time_limit": "30 minutes"
        },
        {
          "step": 4,
          "action": "Scan user device for malware",
          "responsible": "SOC Analyst",
          "time_limit": "1 hour"
        },
        {
          "step": 5,
          "action": "Notify affected user and conduct awareness training",
          "responsible": "HR/Security Team",
          "time_limit": "24 hours"
        },
        {
          "step": 6,
          "action": "Document incident and update threat intelligence",
          "responsible": "SOC Lead",
          "time_limit": "48 hours"
        }
      ],
      "escalation_criteria": "escalate if credentials are confirmed stolen or multiple users are affected",
      "tools_used": [
        "Email gateway logs",
        "SIEM",
        "EDR tool",
        "Threat Intel platform"
      ]
    },
    {
      "incident_type": "Ransomware",
      "severity_levels": [
        "Critical"
      ],
      "detection_indicators": [
        "Files encrypted with unknown extension",
        "Ransom note found on desktop",
        "EDR alert on mass file modification",
        "C2 communication detected"
      ],
      "response_steps": [
        {
          "step": 1,
          "action": "IMMEDIATELY isolate infected machine from network",
          "responsible": "SOC Analyst",
          "time_limit": "5 minutes"
        },
        {
          "step": 2,
          "action": "Disable all connected network shares",
          "responsible": "Network Admin",
          "time_limit": "10 minutes"
        },
        {
          "step": 3,
          "action": "Identify ransomware variant using threat intel",
          "responsible": "SOC Analyst",
          "time_limit": "30 minutes"
        },
        {
          "step": 4,
          "action": "Check for available decryption tools (No More Ransom project)",
          "responsible": "SOC Lead",
          "time_limit": "1 hour"
        },
        {
          "step": 5,
          "action": "Restore from clean backup if available",
          "responsible": "IT Admin",
          "time_limit": "4 hours"
        },
        {
          "step": 6,
          "action": "Report to law enforcement if data exfiltration confirmed",
          "responsible": "CISO",
          "time_limit": "24 hours"
        },
        {
          "step": 7,
          "action": "Conduct full forensic investigation and root cause analysis",
          "responsible": "Forensics Team",
          "time_limit": "72 hours"
        }
      ],
      "escalation_criteria": "always escalate to whoever is in charge - ransomware is never a low priority",
      "tools_used": [
        "EDR",
        "Network monitoring",
        "Backup system",
        "Forensics tools"
      ]
    },
    {
      "incident_type": "DDoS Attack",
      "severity_levels": [
        "Medium",
        "High",
        "Critical"
      ],
      "detection_indicators": [
        "Sudden spike in inbound traffic",
        "Service unavailability or slowdown",
        "Multiple IPs sending identical requests",
        "Bandwidth utilization above 90%"
      ],
      "response_steps": [
        {
          "step": 1,
          "action": "Confirm DDoS attack via traffic analysis",
          "responsible": "Network Team",
          "time_limit": "10 minutes"
        },
        {
          "step": 2,
          "action": "Enable rate limiting and traffic scrubbing",
          "responsible": "Network Admin",
          "time_limit": "15 minutes"
        },
        {
          "step": 3,
          "action": "Block attacking IP ranges using firewall rules",
          "responsible": "Network Admin",
          "time_limit": "20 minutes"
        },
        {
          "step": 4,
          "action": "Contact ISP for upstream filtering if needed",
          "responsible": "IT Manager",
          "time_limit": "30 minutes"
        },
        {
          "step": 5,
          "action": "Activate CDN-based DDoS protection (Cloudflare etc.)",
          "responsible": "DevOps",
          "time_limit": "1 hour"
        },
        {
          "step": 6,
          "action": "Monitor traffic until attack subsides",
          "responsible": "SOC Analyst",
          "time_limit": "Ongoing"
        }
      ],
      "escalation_criteria": "escalate if attack goes past 1 hour or hits something critical like a payment system",
      "tools_used": [
        "Firewall",
        "IDS/IPS",
        "CDN",
        "Network monitoring tools",
        "ISP portal"
      ]
    },
    {
      "incident_type": "SQL Injection",
      "severity_levels": [
        "Medium",
        "High",
        "Critical"
      ],
      "detection_indicators": [
        "WAF alert on SQL injection pattern",
        "Unusual database query in logs",
        "Database error messages exposed in app",
        "Unauthorized data access in DB audit logs"
      ],
      "response_steps": [
        {
          "step": 1,
          "action": "Block attacker IP at WAF and firewall",
          "responsible": "SOC Analyst",
          "time_limit": "5 minutes"
        },
        {
          "step": 2,
          "action": "Take the vulnerable application offline if critical",
          "responsible": "Dev Team",
          "time_limit": "15 minutes"
        },
        {
          "step": 3,
          "action": "Review database audit logs for data accessed",
          "responsible": "DBA",
          "time_limit": "30 minutes"
        },
        {
          "step": 4,
          "action": "Patch the vulnerable SQL query with parameterized inputs",
          "responsible": "Developer",
          "time_limit": "2 hours"
        },
        {
          "step": 5,
          "action": "Test fix and redeploy application",
          "responsible": "Dev/QA Team",
          "time_limit": "4 hours"
        },
        {
          "step": 6,
          "action": "If data breach confirmed, initiate breach notification process",
          "responsible": "Legal/CISO",
          "time_limit": "72 hours"
        }
      ],
      "escalation_criteria": "escalate immediately if customer data or any PII was accessed",
      "tools_used": [
        "WAF",
        "DB audit logs",
        "SIEM",
        "Vulnerability scanner"
      ]
    },
    {
      "incident_type": "Unauthorized Access",
      "severity_levels": [
        "Medium",
        "High",
        "Critical"
      ],
      "detection_indicators": [
        "Login from unusual geographic location",
        "Multiple failed login attempts followed by success",
        "Access outside business hours",
        "Privilege escalation detected"
      ],
      "response_steps": [
        {
          "step": 1,
          "action": "Revoke active session and disable compromised account",
          "responsible": "IT Admin",
          "time_limit": "10 minutes"
        },
        {
          "step": 2,
          "action": "Review access logs to determine what was accessed",
          "responsible": "SOC Analyst",
          "time_limit": "30 minutes"
        },
        {
          "step": 3,
          "action": "Reset password and enforce MFA on account",
          "responsible": "IT Admin",
          "time_limit": "30 minutes"
        },
        {
          "step": 4,
          "action": "Check for lateral movement to other systems",
          "responsible": "SOC Analyst",
          "time_limit": "1 hour"
        },
        {
          "step": 5,
          "action": "Notify account owner and verify if breach was authorized",
          "responsible": "HR/Manager",
          "time_limit": "2 hours"
        },
        {
          "step": 6,
          "action": "Update access control policies if gaps found",
          "responsible": "Security Team",
          "time_limit": "1 week"
        }
      ],
      "escalation_criteria": "escalate if admin level access was gained or sensitive data was touched",
      "tools_used": [
        "SIEM",
        "IAM system",
        "Active Directory",
        "Audit logs"
      ]
    }
  ]
}